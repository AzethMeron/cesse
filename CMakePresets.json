{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "debug",
            "inherits": "base",
            "displayName": "Debug (sanitizers on -- matches compile.sh exactly)",
            "description": "What every test in tests/ has actually been built and run under.",
            "cacheVariables": {
                "CESSE_ENABLE_SANITIZERS": "ON"
            }
        },
        {
            "name": "release",
            "inherits": "base",
            "displayName": "Release (optimized, sanitizers off)",
            "description": "For benchmarking or fast iteration once you trust the code. Not what tests/ has been validated against -- reproduce any failure under the debug preset before trusting it.",
            "cacheVariables": {
                "CESSE_ENABLE_SANITIZERS": "OFF"
            }
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug" },
        { "name": "release", "configurePreset": "release" }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        },
        { "name": "debug", "inherits": "base", "configurePreset": "debug" },
        { "name": "release", "inherits": "base", "configurePreset": "release" }
    ]
}
